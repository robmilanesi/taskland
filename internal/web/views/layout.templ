package views

// Layout is the shared page shell: Pico.css (classless build) styles the
// semantic HTML directly, so pages below need no CSS classes of their own.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Taskland</title>
			<link rel="stylesheet" href="/static/pico.classless.min.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
